{
  "name": "boquitas-local-web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:e2e": "playwright test",
    "contracts:generate": "openapi-typescript contracts/openapi.json -o src/api/schema.d.ts",
    "contracts:check": "node scripts/check-openapi-types.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.0.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
